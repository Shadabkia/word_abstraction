  "mechanics": {
    "groups": [
      {
        "id": "grp_mess",
        "display_name": "آلودگی‌ها (The Mess)",
        "behavior": "transform",
        "requirements": {
          "trigger_ids": ["t_dust", "t_stain", "t_trash", "t_cobweb"]
        },
        "outcomes": {
          "reveal_ids": ["t_icon_res", "t_clean", "t_shiny", "t_fresh"],
          "sound_fx": "sfx_magic_chime"
        },
        "meta": { "hint": "Get rid of the dirty things." }
      },
      {
        "id": "grp_tools",
        "display_name": "ابزار نظافت (Cleaning Tools)",
        "behavior": "transform",
        "requirements": {
          "trigger_ids": ["t_broom", "t_mop", "t_cloth", "t_sponge"]
        },
        "outcomes": {
          "reveal_ids": ["t_icon_act", "t_sweeping", "t_wiping", "t_scrubbing"],
          "sound_fx": "sfx_work_noise"
        },
        "meta": { "hint": "Group the items you hold in your hand." }
      },
      {
        "id": "grp_detergents",
        "display_name": "شوینده‌ها (Detergents)",
        "behavior": "final",
        "requirements": {
          "trigger_ids": ["t_bleach", "t_detergent", "t_powder", "t_glass_cln"]
        },
        "outcomes": { "action": "lock_row" }
      },
      {
        "id": "grp_surfaces",
        "display_name": "سطوح (Surfaces)",
        "behavior": "final",
        "requirements": {
          "trigger_ids": ["t_window", "t_floor", "t_wall", "t_counter"]
        },
        "outcomes": { "action": "lock_row" }
      },
      {
        "id": "grp_actions",
        "display_name": "فعالیت‌ها (Actions)",
        "behavior": "final",
        "requirements": {
          "trigger_ids": ["t_icon_act", "t_sweeping", "t_wiping", "t_scrubbing"]
        },
        "outcomes": { "action": "lock_row" }
      },
      {
        "id": "grp_results",
        "display_name": "نتیجه کار (Results)",
        "behavior": "final",
        "requirements": {
          "trigger_ids": ["t_icon_res", "t_clean", "t_shiny", "t_fresh"]
        },
        "outcomes": { "action": "lock_row" }
      }
    ]
  },

  "layout": {
    "rows": 4,
    "cols": 4,
    "initial_grid": [
      ["t_bleach",  "t_dust",    "t_broom",   "t_window"],
      ["t_detergent","t_stain",   "t_mop",     "t_floor"],
      ["t_powder",  "t_trash",   "t_cloth",   "t_wall"],
      ["t_glass_cln","t_cobweb",  "t_sponge",  "t_counter"]
